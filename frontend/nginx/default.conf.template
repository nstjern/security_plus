# Rendered by the nginx entrypoint, which substitutes ${API_ORIGIN} from the environment.
# Only exported variables are substituted, so nginx's own $uri survives.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # style-src allows inline because React writes the accuracy bar width as a style attribute.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${API_ORIGIN}; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Asset filenames carry a content hash, so a stale copy is impossible.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-side routing: unknown paths are handed to the application, not refused.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
