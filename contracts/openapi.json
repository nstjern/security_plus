{
  "components": {
    "schemas": {
      "AnswerRequest": {
        "description": "A displayed letter, or null to skip the question.",
        "properties": {
          "choice": {
            "anyOf": [
              {
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice"
          }
        },
        "title": "AnswerRequest",
        "type": "object"
      },
      "AnswerResponse": {
        "properties": {
          "correct_choice": {
            "title": "Correct Choice",
            "type": "string"
          },
          "correct_choice_text": {
            "title": "Correct Choice Text",
            "type": "string"
          },
          "correction_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correction Note"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "next_available": {
            "title": "Next Available",
            "type": "boolean"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "result": {
            "$ref": "#/components/schemas/AttemptResult"
          },
          "session_status": {
            "title": "Session Status",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "result",
          "correct_choice",
          "correct_choice_text",
          "explanation",
          "correction_note",
          "position",
          "total",
          "session_status",
          "next_available"
        ],
        "title": "AnswerResponse",
        "type": "object"
      },
      "AttemptResult": {
        "enum": [
          "correct",
          "incorrect",
          "skipped"
        ],
        "title": "AttemptResult",
        "type": "string"
      },
      "CatalogResponse": {
        "description": "Every value that can be used to filter a study session.",
