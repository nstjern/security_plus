# Copy to .env for local overrides. .env is gitignored and never committed.
# The defaults in compose.yml are sufficient for development; nothing here is required.

# development | test | production
ENVIRONMENT=development

# Keys the digest of stored session tokens. Changing it signs everyone out. The application
# refuses to start in production while this matches the development default, so generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-not-for-production

DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# JSON array; must match the frontend's origin exactly for cookies to be sent.
CORS_ORIGINS=["http://localhost:5173"]

# Absolute path inside the container. Only override when running outside Docker.
# QUESTIONS_PATH=/srv/questions.json

LOG_LEVEL=INFO

# How long a sign-in lasts before the session expires.
SESSION_LIFETIME_HOURS=24

# Cookie names, only worth changing if they collide with something else on the origin.
# SESSION_COOKIE_NAME=sp_session
# CSRF_COOKIE_NAME=sp_csrf
